# ────────────────────────────────────────────────────────────────────────
# SZELVÉNYKIRÁLY PRO - Environment Variables
# Kizárólag ingyenes forrásokat használ (SofaScore/Flashscore
# scraping + statisztikai Poisson-modell). Nincs szükség
# semmilyen fizetős API-kulcsra.
# ────────────────────────────────────────────────────────────────────────

# TELEGRAM
TELEGRAM_BOT_TOKEN=your_bot_token_here
TIPPMIX_FREE_CHAT_ID=your_free_channel_id
TIPPMIX_VIP_CHAT_ID=your_vip_channel_id
TIPPMIX_VIP_URL=https://tippmix.vercel.app/vip
TIPPMIX_DASHBOARD_URL=https://tippmix.vercel.app

# DATABASE (ez az önmagát tanító adatbázis)
TIPPMIX_DB_PATH=data/tippmix.db

# TIPS CONFIGURATION
TIPPMIX_SLOT=DAY
TIPPMIX_ENGINE=poisson

# MINIMUM REQUIREMENTS
TIPPMIX_MIN_VIP_TIPS=6
TIPPMIX_MIN_FREE_TIPS=3
TIPPMIX_MAX_TIPS_VIP=12
TIPPMIX_MAX_TIPS_FREE=3

# LEAGUE FILTERING
TIPPMIX_ALLOW_NON_PRO_LEAGUES=0
TIPPMIX_MIN_PRO_TIPS=3

# RATE LIMITING
TIPPMIX_MAX_POISSON_PER_RUN=1000
TIPPMIX_MAX_DB_WRITES_PER_RUN=50
TIPPMIX_MAX_MATCHES_PER_RUN=100

# ROI DISPLAY
# (Automatic - no config needed)

# DEDUPLICATION
# (Automatic - no config needed)

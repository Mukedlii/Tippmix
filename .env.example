# Copy to .env locally (DO NOT commit .env)

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=

# OpenAI
OPENAI_API_KEY=
TIPPMIX_MODEL=gpt-5-mini
TIPPMIX_TEMP=0.25

# VIP combo odds profile (target: 6-fold total odds ~10–15)
TIPPMIX_VIP_ODDS_MIN=1.35
TIPPMIX_VIP_ODDS_MAX=1.85
TIPPMIX_VIP_HIGH_ODDS_THRESHOLD=1.75
TIPPMIX_VIP_MAX_HIGH_ODDS=2
TIPPMIX_VIP_REQUIRE_ODDS=1

# FREE combo odds profile (target: 4-fold total odds ~6–10)
# If you want 4 tips instead of 3, set TIPPMIX_MIN_FREE=4 in Actions env/vars.
TIPPMIX_FREE_ODDS_MIN=1.40
TIPPMIX_FREE_ODDS_MAX=2.10
TIPPMIX_FREE_REQUIRE_ODDS=0

# VIP bonus combo (extra 4 tips shown in VIP message)
TIPPMIX_VIP_BONUS_COUNT=4
TIPPMIX_VIP_BONUS_ODDS_MIN=1.70
TIPPMIX_VIP_BONUS_ODDS_MAX=2.60
TIPPMIX_VIP_BONUS_HIGH_ODDS_THRESHOLD=2.30
TIPPMIX_VIP_BONUS_MAX_HIGH_ODDS=2

# Sports data provider
# Choose ONE:
# SPORTS_API_KEY=              # API-FOOTBALL / API-Sports
SPORTSDATAIO_API=
# SPORTMONKS_API_TOKEN=

# Optional explicit provider override:
SPORTS_DATA_PROVIDER=sportsdataio

# Odds supplement (optional): The Odds API
ODDS_API_KEY=
ODDS_REGIONS=eu
ODDS_MAX_REQUESTS_PER_RUN=6
# Optional: comma-separated The Odds API sport keys to query
# ODDS_SPORT_KEYS=soccer_epl,soccer_uefa_champs_league

# Slots / minimums
TIPPMIX_SLOT=DAY             # DAY or EVENING
TIPPMIX_MIN_VIP=6
TIPPMIX_MIN_FREE=3

# Optional blacklist (avoid competitions where the provider often has NO_DATA / missing final scores)
# Comma-separated; case-insensitive substring match.
# Example: TIPPMIX_BLOCK_COUNTRIES=Syria,Congo-DR
# Example: TIPPMIX_BLOCK_LEAGUES=Premier League Syria,Ligue 1 Congo
TIPPMIX_BLOCK_COUNTRIES=
TIPPMIX_BLOCK_LEAGUES=

# Quality gates
TIPPMIX_ALLOW_YOUTH=0
TIPPMIX_ALLOW_FRIENDLY=0

# Pool sizing + odds enrichment limits
TIPPMIX_MAX_DAYS_AHEAD=0
TIPPMIX_MIN_POOL=21
TIPPMIX_ODDS_LOOKUP_LIMIT=120

# Database
TIPPMIX_DB_PATH=data/tippmix.db

# Content quality controls (recommended)
TIPPMIX_MAX_DRAWS_VIP=1
TIPPMIX_MAX_DRAWS_FREE=1
